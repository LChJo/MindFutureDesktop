# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# Dependency directories
node_modules/
# Include all resources directory
!src-tauri/resources
# But include bundled Node.js npm for Windows release
!src-tauri/resources/nodejs-windows/node_modules/
# The macOS binary is generated by npm run prepare:nodejs-macos.
/src-tauri/resources/nodejs-macos/node
!src-tauri/resources/nodejs-macos/lib/
!src-tauri/resources/nodejs-macos/lib/node_modules/
!src-tauri/resources/nodejs-macos/version.txt
# Include bundled coworks-sidecar runtime JS files (node_modules installed locally)
!src-tauri/resources/coworks-sidecar/*.js
# Exclude TypeScript build artifacts (declarations + source maps, not needed at runtime)
src-tauri/resources/coworks-sidecar/*.d.ts
src-tauri/resources/coworks-sidecar/*.d.ts.map
src-tauri/resources/coworks-sidecar/*.js.map
# Include bundled feishu event listener (esbuild single-file bundle, no node_modules)
!src-tauri/resources/feishu/event-listener.cjs

# Environment variables
.env

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific
.DS_Store

# Rust/Tauri build intermediates (exclude but keep release artifacts)
src-tauri/target/debug/
src-tauri/target/release/build/
src-tauri/target/release/deps/
src-tauri/target/release/incremental/
src-tauri/target/release/.fingerprint/
src-tauri/target/release/examples/
src-tauri/target/release/.cargo-lock
src-tauri/target/release/wix/
src-tauri/target/CACHEDIR.TAG
src-tauri/target/.rustc_info.json

# Keep these (not ignored):
# src-tauri/target/release/app.exe
# src-tauri/target/release/bundle/

# Intermediate files
*.d
*.rmeta
*.rlib
*.pdb
*.dll.lib
*.lib

# Temp files
nul
*.tmp

# Build outputs
dist/
output/
coverage/

# Release binaries (keep bundle/ for installers)
src-tauri/target/release/app.exe

# Claude Code and Task Master (local config)
.claude/settings.local.json
.taskmaster/

# Release installers are published as release assets.
*.dmg
/releases/*.exe
/releases/*.msi

# macOS build artifacts
src-tauri/target/universal-apple-darwin/
src-tauri/target/x86_64-apple-darwin/
src-tauri/target/aarch64-apple-darwin/
tmpclaude-*-cwd
docs/.claude/settings.local.json

# WinPTY legacy binaries (unused, superseded by ConPTY)
src-tauri/resources/nodejs-windows/**/winpty*.dll
src-tauri/resources/nodejs-windows/**/winpty-agent.exe
