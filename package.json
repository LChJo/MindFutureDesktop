{
  "name": "moonton-claude-desktop",
  "version": "1.2.97",
  "description": "Moonton Claude Desktop - Virtual Desktop Environment",
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "predev": "npm run sync-version && npm run build:feishu-listener",
    "dev": "tauri dev",
    "prebuild": "npm run sync-version && npm run build:feishu-listener",
    "build": "tauri build",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:mac": "npm run sync-version && tauri build --target universal-apple-darwin",
    "build:mac-intel": "npm run sync-version && tauri build --target x86_64-apple-darwin",
    "build:mac-arm": "npm run sync-version && tauri build --target aarch64-apple-darwin",
    "build:windows": "npm run sync-version && tauri build --target x86_64-pc-windows-msvc",
    "prepare:nodejs-macos": "cd src-tauri/resources && ./prepare-nodejs-macos.sh",
    "build:coworks-sidecar": "node scripts/build-coworks-sidecar.js",
    "build:feishu-listener": "node scripts/build-feishu-listener.js",
    "postinstall": "cd src-tauri/resources/coworks-sidecar && npm install --omit=dev && cd ../../../sidecar/feishu && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "vue-tsc --noEmit && eslint src --fix && vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src/**/*.{vue,ts,tsx,less}"
  },
  "keywords": [
    "vue",
    "desktop",
    "virtual-desktop",
    "terminal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^15.0.12",
    "pinia": "^2.3.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@pinia/testing": "^0.1.7",
    "@tauri-apps/cli": "^2.9.6",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "happy-dom": "^20.9.0",
    "less": "^4.4.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.1.8"
  }
}
