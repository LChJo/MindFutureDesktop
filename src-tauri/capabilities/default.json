{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.MoontonClaudeDesktop/**" },
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.MoontonClaudeDesktop/**" },
        { "path": "$HOME/.claude/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.MoontonClaudeDesktop/**" },
        { "path": "$HOME/.claude/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.MoontonClaudeDesktop/**" },
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
