{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Moonton Claude Desktop",
  "version": "../package.json",
  "identifier": "com.moonton.claudedesktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "vite build",
    "beforeBuildCommand": "vue-tsc --noEmit && vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Moonton Claude Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/nodejs-windows/**/*",
      "resources/nodejs-macos/**/*",
      "resources/coworks-sidecar/**/*",
      "resources/ccr/**/*",
      "resources/dist/**/*",
      "resources/mcd-cli/**/*",
      "resources/feishu/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": "65431FBBA5AAE5E9BA3F670A3C207A38581BE7BD",
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "",
      "entitlements": "entitlements.plist",
      "signingIdentity": "Moonton Claude Desktop Signing",
      "providerShortName": null,
      "hardenedRuntime": true
    }
  }
}
