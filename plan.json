{
  "技术栈": {
	"TypeScript": "v5.5.4",
	"Vue.js": "v3.3.13",
	"Less.js": "",
	"Gulp.js": ""
  },
  "图标库": "Font Awesome v6.5.1",
  "功能需求": {
    "目标 ":"一个给claude code cli等cli使用的可交互虚拟桌面环境",
    "功能列表": [   
      "虚拟桌面环境",
        {
            "子功能": [
                "快捷图标的创建与删除",
                "图标的拖拽排序",
                "点击图标触发子窗口，子窗口统一为对话框形式，子窗口进程是一个独立的终端模拟器",
                "多窗口同时打开与切换",
                "窗口的最小化、最大化、关闭",
                "配置环境变量"
                ]
        },
      "文件管理器",
        {
            "子功能": [
            "文件/文件夹的创建、删除、重命名",
            "文件/文件夹的拖拽移动",
            "文件/文件夹的复制粘贴",
            "多选文件/文件夹",
            "文件预览（图片、文本）"
            ]
        },
      "终端模拟器",
        {
            "子功能": [
              "系统终端的模拟",
              "直接调用claude code cli等cli",
              "每个被图标打开的子窗口都是一个终端的模拟器"
            ]
        },
      "文本编辑器",
        {
            "子功能": [
              "启动系统文本编辑器或指定文本编辑器"
            ]
        },
      "任务管理器",
        {
            "子功能": [
              "查看当前运行的终端，子窗口等任务",
              "结束指定终端/子窗口等任务"
            ]
        },
      "系统设置",
        {
            "子功能": [
              "环境变量配置",
              "终端cli默认设置",
              "快捷方式类型和快捷方式启动参数配置",
              "快捷键设置"
            ]
        },
      "claude code plugin插件市场",
        {
            "子功能": [
              "claude code 插件的浏览与搜索",
              "claude code 插件的安装与卸载",
              "已安装插件的管理"
            ]
        }
    ]
    }
}